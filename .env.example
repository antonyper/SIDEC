# Copia este archivo como ".env" en la raíz del proyecto y completa los valores
# antes de correr "docker compose up -d --build" en la VPS.

# Dominio (o subdominio) que apunta a la IP de la VPS. Caddy generará el
# certificado HTTPS automáticamente para este dominio.
DOMAIN=tudominio.pe

# Credenciales de la base de datos (elige una contraseña fuerte).
DATABASE_NAME=sidec
DATABASE_USER=sidec
DATABASE_PASSWORD=cambia-esta-contrasena

# Clave secreta para firmar los tokens de sesión (JWT).
# Genera una nueva con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave
